# Mock mode is safe for local demos and does not call Google Cloud.
AI_PROVIDER=mock
PORT=3000
LOG_LEVEL=info

# Per-client gateway limits. x-client-id is a quota partition key, not authentication.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
MAX_PROMPT_LENGTH=4000

# Required only when AI_PROVIDER=vertex. Do not put API keys in this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
